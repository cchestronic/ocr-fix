<View>
  <Style>.lsf-richtext { white-space: pre-wrap; }</Style>
  <View style="display: flex; gap: 1em">
    <View style="flex: 1; min-width: 0">
      <Header value="Page image"/>
      <Image name="page" value="$page_image" zoomControl="true"/>
    </View>
    <View style="flex: 1; min-width: 0">
      <Header value="Previous paragraph (context, read-only)" size="6"/>
      <Text name="prev" value="$context_prev" granularity="symbol"/>
      <Header value="OCR text (fix this one)" size="5"/>
      <Text name="source" value="$source_text" granularity="symbol"/>
      <Header value="Protected spans" size="6"/>
      <Text name="spans" value="$placeholder_list"/>
      <Header value="Next paragraph (context, read-only)" size="6"/>
      <Text name="next" value="$context_next"/>
    </View>
  </View>
  <Header value="Gold text: the PDF text with OCR damage removed, nothing else. Keep every ⟨M#⟩ ⟨T#⟩ unless its span is misclassified-text. 〈?〉 = unrecoverable."/>
  <TextArea name="gold_text" toName="source" editable="true" maxSubmissions="1" rows="10" required="true"/>
  <Header value="Span labels, one per line: M1=ok | M1=broken | M1=misclassified-text"/>
  <TextArea name="span_labels" toName="source" editable="true" maxSubmissions="1" rows="3"/>
  <Header value="Structure"/>
  <Choices name="structure" toName="source" choice="single" showInline="true" required="true">
    <Choice value="none"/>
    <Choice value="merge-with-next"/>
    <Choice value="split-at"/>
  </Choices>
  <Header value="split-at: character offset in the gold text where the second paragraph starts" size="6"/>
  <Number name="split_offset" toName="source" min="1"/>
  <Header value="Notes (optional)" size="6"/>
  <TextArea name="notes" toName="source" editable="true" maxSubmissions="1" rows="2"/>
</View>
