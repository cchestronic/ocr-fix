# =============================================================================================
# Example: several GPU servers. Copy to configs/profiles/cluster.yaml, change the addresses,
# copy it to EVERY machine (the same file everywhere), and set it once on each:
#   echo 'export OCRFIX_PROFILE=cluster' >> ~/.bashrc
# (A *.yaml.example file is not a profile.) Every setting is explained in rtx5090.yaml.
# =============================================================================================
#
# The machines in this example:
#   gpu1  10.0.0.11  8x H200   base model on GPUs 0-1, trained model on GPUs 2-7
#   gpu2  10.0.0.12  8x H200   trained model on all 8 GPUs
#   gpu3  10.0.0.13  8x H200   trained model on all 8 GPUs
#   cpu1  (any)               runs the ocrfix commands (or run them on gpu1)
#
# Start the servers: on EACH GPU server, the same command; it starts the groups listed below
# for that machine (both kinds at once):
#   gpu1$ ./ocrfix serve --set correct.model=/models/ocrfix-sft-merged
#   gpu2$ ./ocrfix serve --set correct.model=/models/ocrfix-sft-merged
#   gpu3$ ./ocrfix serve --set correct.model=/models/ocrfix-sft-merged
# (Better: set correct.model in configs/stages/correct.yaml on every machine, then just
# `./ocrfix serve`.) If a machine doesn't recognise its own address, add --host 10.0.0.12.
#
# Check from the command machine:  curl http://10.0.0.12:8100/health
# Then run the commands anywhere, as usual: they send scoring to the 2 base servers and
# correcting to the 6 + 8 + 8 = 22 trained servers:
#   ./ocrfix correct data/real/scored data/real/refined --set correct.model=/models/ocrfix-sft-merged
#   ./ocrfix config --key hw.infer.correct_urls        # check the list
#
# Rules:
#   - correct.model must be the same path on every machine (copy the merged model to each).
#   - The servers have no password: internal network addresses only; the firewall must let
#     the command machine reach ports 8000+ / 8100+ on the GPU servers.
#   - `./ocrfix pipeline` uses these servers when they answer; it never starts or stops
#     servers on other machines. Training runs on the machine the pipeline runs on.
#   - The scoring passes need only base servers: for them you can restart gpu2 / gpu3 with
#     `./ocrfix serve --only base` after adding base groups for them below (and restart
#     with trained groups for `correct`). Simplest: keep this list and accept that scoring
#     uses gpu1's 2 GPUs only, or give gpu1 more base GPUs.

model: /models/Qwen3.5-9B             # the base model, same path on every machine

hw:
  name: cluster
  n_gpus: 8                           # GPUs of each GPU server (`gpus: all` = 0..7)
  dtype: bfloat16
  attn_impl: flash_attention_2
  vllm_attention_backend: FLASH_ATTN

  train:                              # training runs on one GPU server (all its GPUs)
    mode: lora
    per_device_batch_size: 8
    max_seq_len: 8192
    gradient_checkpointing: true
    optim: adamw_torch_fused
    packing: true
    distributed: auto
    fsdp:
      sharding: full_shard auto_wrap
      layer_cls: Qwen3_5DecoderLayer

  # Every vLLM server group, on every machine. Ports are counted per machine: gpu1's base
  # engines 8000-8001, its trained engines 8100-8105; gpu2's and gpu3's trained 8100-8107.
  # Memory: no GPU is shared here, so every engine gets 0.88.
  servers:
    - {model: base,    host: 10.0.0.11, gpus: [0, 1]}
    - {model: trained, host: 10.0.0.11, gpus: [2, 3, 4, 5, 6, 7]}
    - {model: trained, host: 10.0.0.12, gpus: all}
    - {model: trained, host: 10.0.0.13, gpus: all}

  infer:
    gpus_per_engine: 1
    ports: {base: 8000, trained: 8100}
    max_model_len: 8192
    max_num_seqs: 256
    concurrency: null                 # automatic: engines x max_num_seqs

  scorer:
    max_batch_tokens: 32768
    logits_chunk: 4096
